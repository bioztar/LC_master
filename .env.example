# LLM provider switch: openai | gemini
LLM_PROVIDER=gemini

# --- OpenAI (used if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Gemini / Google AI Studio (used if LLM_PROVIDER=gemini) ---
# Get key at https://aistudio.google.com  (free tier)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Langfuse (cloud: https://cloud.langfuse.com  |  self-host: docker compose up)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Storage paths
CHROMA_DIR=./data/chroma
CHECKPOINT_DB=./data/checkpoints.sqlite
